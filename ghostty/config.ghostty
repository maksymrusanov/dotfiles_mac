# ~/.config/ghostty/config

font-family = JetBrainsMono Nerd Font Mono
font-size = 19

window-padding-x = 10
window-padding-y = 10


# Optional transparency
background-opacity = 0.7
background = #000000
foreground = #FFCCCC

cursor-color = #FF0000
cursor-text = #000000

selection-background = #660000
selection-foreground = #FFFFFF

palette = 0=#111111
palette = 1=#FF0000
palette = 2=#FF2222
palette = 3=#FF5500
palette = 4=#AA0000
palette = 5=#FF0055
palette = 6=#FF3333
palette = 7=#EEEEEE

palette = 8=#333333
palette = 9=#FF1111
palette = 10=#FF4444
palette = 11=#FF7700
palette = 12=#FF3333
palette = 13=#FF0066
palette = 14=#FF5555
palette = 15=#FFFFFF
